{
  "name": "mire",
  "productName": "Mire",
  "version": "1.0.0",
  "description": "Lecteur multimédia, frontend de streaming intégré, de télévision Freebox et de jeux",
  "main": "dist/main/index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch --electron",
    "drm:compte": "node scripts/drm.js compte",
    "drm:connexion": "node scripts/drm.js connexion",
    "drm:signer": "node scripts/drm.js signer",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/shared/tsconfig.json",
    "test": "node --test \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 test/e2e/smoke.e2e.js",
    "dist": "node -e \"require('electron')\" && node scripts/build.mjs && npx --yes electron-builder@26.17.0 --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "7zip-bin": "5.2.0",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "https://github.com/castlabs/electron-releases#v44.9.3+wvcus",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-content": "2.20.1",
    "@ghostery/adblocker-electron-preload": "2.20.1",
    "@ghostery/adblocker-extended-selectors": "2.20.1",
    "tldts-experimental": "7.4.16",
    "bufferutil": "file:vendor/bufferutil-4.0.9-mire.1.tgz",
    "ip": "file:vendor/ip-2.0.1-mire.1.tgz",
    "ip-set": "file:vendor/ip-set-3.0.0-mire.1.tgz",
    "node-domexception": "file:vendor/node-domexception-1.0.0-mire.1.tgz",
    "utf-8-validate": "file:vendor/utf-8-validate-6.0.5-mire.1.tgz",
    "utp-native": "file:vendor/utp-native-2.5.3-mire.1.tgz",
    "webrtc-polyfill": "file:vendor/webrtc-polyfill-1.2.2-mire.1.tgz"
  },
  "build": {
    "appId": "fr.mire.app",
    "productName": "Mire",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "afterPack": "./scripts/drm.js",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
