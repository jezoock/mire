{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jezoock/mire/blob/main/packages/plugin-sdk/schema/mire-plugin.schema.json",
  "title": "Manifeste d'un plugin de Mire (mire-plugin.json)",
  "description": "Gardé d'accord avec le validateur de @mire/plugin-sdk par un test. La cohérence entre le niveau et les contributions ou les permissions, le préfixe « mire. », les fichiers et les textes sont vérifiés par « mire-plugin validate ».",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "engines", "level", "contributes", "i18n"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/pluginId"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Version du plugin (semver)."
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mire"],
      "properties": {
        "mire": {
          "$ref": "#/$defs/versionRange",
          "description": "Versions de Mire compatibles."
        }
      }
    },
    "level": {
      "enum": ["data", "code", "privileged"],
      "description": "data : rien ne s'exécute ; code : hôte isolé ; privileged : processus principal."
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sources"
          }
        },
        "metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata"
          }
        },
        "taggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taggers"
          }
        },
        "search": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/search"
          }
        },
        "subtitles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subtitles"
          }
        },
        "webExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/webExtensions"
          }
        },
        "downloaders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/downloaders"
          }
        },
        "webApps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/webApps"
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/apps"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/systems"
          }
        },
        "packs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packs"
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pages"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/themes"
          }
        },
        "palettes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/palettes"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/languages"
          }
        },
        "gamepads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gamepads"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          },
          "description": "Hôtes Internet joints."
        },
        "folders": {
          "type": "boolean",
          "description": "Dossiers demandés à l'utilisateur quand le plugin en a besoin."
        },
        "localNetwork": {
          "type": "boolean",
          "description": "Réseau local (niveau privileged)."
        },
        "launch": {
          "type": "boolean",
          "description": "Lancement de programmes (niveau privileged)."
        },
        "webViews": {
          "type": "boolean",
          "description": "Vues web (niveau privileged)."
        },
        "deleteFiles": {
          "type": "boolean",
          "description": "Suppression de fichiers (niveau privileged)."
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Plugins requis : identifiant → plage de versions.",
      "propertyNames": {
        "$ref": "#/$defs/pluginId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/versionRange"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,63}$",
            "description": "Clé ; libellé : settings.<key>.label dans les textes du plugin."
          },
          "type": {
            "enum": ["text", "secret", "choice", "toggle", "path", "list"]
          },
          "default": {
            "type": ["string", "boolean", "array"],
            "items": {
              "type": "string"
            }
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-zA-Z0-9-]{0,63}$"
            },
            "description": "Valeurs d'un réglage choice ; libellés : settings.<key>.options.<valeur>."
          }
        }
      }
    },
    "i18n": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Dossier des textes (en.json obligatoire, fr.json aussi pour le dépôt officiel)."
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
      "description": "Identifiant en notation inversée ; le préfixe « mire. » est réservé au dépôt officiel."
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*/)?\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$",
      "description": "Chemin relatif au dossier du plugin, séparateurs « / », sans « . » ni « .. »."
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Plage de versions semver (^1.0.0, >=1.0.0 <2.0.0, 1.x || 2.x)."
    },
    "infos": {
      "type": "object",
      "description": "Infos posées : identifiant → déclaration ; nom affiché : infos.<id> dans les textes du plugin.",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["text", "number", "boolean", "list"]
          },
          "searchable": {
            "type": "boolean"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "main": {
          "$ref": "#/$defs/path",
          "description": "Fichier JavaScript de la contribution, relatif au dossier du plugin."
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localId"
          },
          "uniqueItems": true,
          "description": "Tags posés ; nom affiché : tags.<id> dans les textes du plugin."
        },
        "infos": {
          "$ref": "#/$defs/infos"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main", "kinds"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "main": {
          "$ref": "#/$defs/path",
          "description": "Fichier JavaScript de la contribution, relatif au dossier du plugin."
        },
        "kinds": {
          "type": "array",
          "items": {
            "enum": ["video", "album", "rom", "pc"]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Natures d'éléments décrites."
        },
        "infos": {
          "$ref": "#/$defs/infos"
        }
      }
    },
    "taggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "main": {
          "$ref": "#/$defs/path",
          "description": "Fichier JavaScript de la contribution, relatif au dossier du plugin."
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localId"
          },
          "uniqueItems": true,
          "description": "Tags posés ; nom affiché : tags.<id> dans les textes du plugin."
        },
        "infos": {
          "$ref": "#/$defs/infos"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "main": {
          "$ref": "#/$defs/path",
          "description": "Fichier JavaScript de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "main": {
          "$ref": "#/$defs/path",
          "description": "Fichier JavaScript de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "webExtensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "main": {
          "$ref": "#/$defs/path",
          "description": "Fichier JavaScript de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "downloaders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "main": {
          "$ref": "#/$defs/path",
          "description": "Fichier JavaScript de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "webApps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "palettes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    },
    "gamepads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "file": {
          "$ref": "#/$defs/path",
          "description": "Fichier de données de la contribution, relatif au dossier du plugin."
        }
      }
    }
  }
}
